<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	  <TargetFrameworks>net10.0</TargetFrameworks>
	<PackageId>FontStashSharp.Kni</PackageId>
    <AssemblyName>FontStashSharp.Kni</AssemblyName>
    <Description>FontStashSharp for Kni</Description>
    <DefineConstants>$(DefineConstants);MONOGAME</DefineConstants>
    <OutputPath>bin\Kni\$(Configuration)</OutputPath>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cyotek.Drawing.BitmapFont" Version="$(CyotekDrawingBitmapFontVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\FontStashSharp\**\*.cs" LinkBase="FontStashSharp" />
    <Compile Remove="..\FontStashSharp\obj\**\*.cs" LinkBase="FontStashSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\fontstashbase\src\FontStashSharp.Base\FontStashSharp.Base.csproj" />
    <ProjectReference Include="..\..\..\fontstashbase\src\FontStashSharp.Rasterizers.StbTrueTypeSharp\FontStashSharp.Rasterizers.StbTrueTypeSharp.csproj" />
    <ProjectReference Include="..\..\..\kni\src\Xna.Framework.Graphics\Xna.Framework.Graphics.csproj" />
    <ProjectReference Include="..\..\..\kni\ThirdParty\StbImageSharp\src\StbImageSharp.csproj" />
  </ItemGroup>
</Project>
